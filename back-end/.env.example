HOST=127.0.0.1
PORT=3333
DATABASE_URL=postgresql://project_vet:project_vet@localhost:5432/project_vet
JWT_SECRET=change-me
NODE_ENV=development
GROQ_API_KEY=change-me

# SMTP Hostinger (esqueci a senha / e-mails transacionais)
# Preferir 587 (STARTTLS). Se 465 der ETIMEDOUT na sua rede, use 587.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USER=suporte@boxvet.com.br
SMTP_PASS=
SMTP_FROM=suporte@boxvet.com.br
MAIL_FROM_NAME=BoxVet

# Obrigatório no Docker (seed roda no start). Local: npm run seed:platform-admin
PLATFORM_ADMIN_NAME=Admin BoxVet
PLATFORM_ADMIN_EMAIL=admin@boxvet.app
PLATFORM_ADMIN_PASSWORD=troque-esta-senha
